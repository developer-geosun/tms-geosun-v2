# =============================================================================
# TMS GeoSun — шаблон конфігурації (docker compose, backend, frontend)
# Скопіюйте до .env і змініть значення під своє середовище.
# =============================================================================

# -----------------------------------------------------------------------------
# Spring / профіль застосунку
# -----------------------------------------------------------------------------
# Активний профіль Spring Boot (dev, prod тощо).
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Порти сервісів
# -----------------------------------------------------------------------------
# Порт backend API (Spring Boot) на хості.
SERVER_PORT=8080
# Порт Angular dev-сервера (локальна розробка frontend).
FRONTEND_PORT=4200
# Конфігурація збірки frontend: development | production.
FRONTEND_BUILD_CONFIGURATION=production

# -----------------------------------------------------------------------------
# Публічний доступ до backend API: ngrok | static-ip
# Frontend на GitHub Pages; API — окремо (ngrok-тунель або статична IP).
# -----------------------------------------------------------------------------
# Режим публічного доступу до API.
PUBLIC_ACCESS_MODE=static-ip

# Профілі Docker Compose (ngrok — піднімає контейнер тунелю).
# COMPOSE_PROFILES=ngrok

# Публічний URL backend API (для frontend, CORS, листів).
# У режимі static-ip — проброс SERVER_PORT на роутері (приклад Vodafone «Статична IP»).
# У режимі ngrok має збігатися з https://<NGROK_DOMAIN>.
PUBLIC_API_URL=http://178.136.237.7:8080

# --- Режим static-ip (за замовчуванням) ---
# static-ip — без тунелю; пробросьте SERVER_PORT на роутері на цю машину.

# --- Режим ngrok (альтернатива static-ip) ---
# PUBLIC_ACCESS_MODE=ngrok
# COMPOSE_PROFILES=ngrok
# PUBLIC_API_URL=https://<NGROK_DOMAIN>
# (для GitHub Pages secret API_URL має збігатися з PUBLIC_API_URL)

# --- Ngrok (потрібен COMPOSE_PROFILES=ngrok) ---
# Токен з dashboard.ngrok.com.
NGROK_AUTHTOKEN=
# Зарезервований домен ngrok (без https://).
NGROK_DOMAIN=
# Web UI ngrok для перегляду запитів (localhost:4040).
NGROK_INSPECT_PORT=4040
# Web UI ngrok у dev-профілі Compose (localhost:4041).
NGROK_DEV_INSPECT_PORT=4041

# Порт API Gateway (маршрутизація між сервісами в Compose).
GATEWAY_PORT=8081
# Порт gateway у dev-профілі Compose (localhost:8082).
GATEWAY_DEV_PORT=8082

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
# Ім'я бази даних, користувач і паролі для контейнера MySQL.
MYSQL_DATABASE=tms_auth
MYSQL_USER=tms_user
MYSQL_PASSWORD=tms_password
MYSQL_ROOT_PASSWORD=root
# Порт MySQL на хості (3307, щоб не конфліктувати з локальним 3306).
MYSQL_HOST_PORT=3307

# -----------------------------------------------------------------------------
# JWT (автентифікація)
# -----------------------------------------------------------------------------
# Секрет підпису токенів (мінімум 32 символи; змініть у production).
JWT_SECRET=replace-me-with-strong-secret-of-at-least-32-characters
# Опційні issuer/audience для перевірки JWT (порожньо — без перевірки).
JWT_ISSUER=
JWT_AUDIENCE=
# Час життя access-токена (секунди). 900 = 15 хв.
JWT_EXPIRES_SECONDS=900
# Час життя refresh-токена (секунди). 604800 = 7 днів.
JWT_REFRESH_EXPIRES_SECONDS=604800

# -----------------------------------------------------------------------------
# Суперадмін
# -----------------------------------------------------------------------------
# Пароль для чутливих admin-операцій (POST /api/v1/admin/super-admin/verify-password).
SUPER_ADMIN_PASSWORD=change-me-super-admin-password

# -----------------------------------------------------------------------------
# Верифікація email та скидання пароля
# -----------------------------------------------------------------------------
# Час дії посилання підтвердження email (секунди). 86400 = 24 год.
EMAIL_VERIFICATION_EXPIRES_SECONDS=86400
# Час дії посилання скидання пароля (секунди). 3600 = 1 год.
PASSWORD_RESET_EXPIRES_SECONDS=3600

# Базові URL посилань у листах — на frontend (локально або GitHub Pages), не на API.
# Fallback без ngrok; якщо NGROK_DOMAIN заданий — у листі завжди береться він.
# Також визначає Angular base-href для npm run deploy (sync-from-env.mjs).
EMAIL_VERIFICATION_LINK_BASE=http://localhost:4200/verify-email
# Має використовувати той самий шлях деплою, що й EMAIL_VERIFICATION_LINK_BASE.
PASSWORD_RESET_LINK_BASE=http://localhost:4200/reset-password

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Дозволені origin frontend (через кому). GitHub Pages та інші публічні URL.
CORS_ALLOWED_ORIGIN_PATTERNS=https://developer-geosun.github.io

# -----------------------------------------------------------------------------
# SMTP (відправка листів)
# -----------------------------------------------------------------------------
# Локально: mailhog (docker compose). Production: smtp.gmail.com тощо.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Увімкнути SMTP AUTH і STARTTLS (true/false).
SMTP_AUTH=false
SMTP_STARTTLS=false
# Адреса відправника в полі From.
MAIL_FROM=no-reply@example.com

# -----------------------------------------------------------------------------
# Rate limiting (обмеження частоти запитів)
# -----------------------------------------------------------------------------
# Логін: макс. спроб і вікно (секунди).
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# Мін. інтервал між повторною відправкою листа верифікації (секунди).
RATE_LIMIT_RESEND_VERIFICATION_SECONDS=60
# Мін. інтервал між запитами «забули пароль» (секунди).
RATE_LIMIT_FORGOT_PASSWORD_SECONDS=60
# Refresh-токен: макс. запитів за вікно (секунди).
RATE_LIMIT_REFRESH_MAX_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Очищення застарілих токенів
# -----------------------------------------------------------------------------
# Скільки днів зберігати відкликані/прострочені токени перед видаленням.
TOKEN_CLEANUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Зовнішні API (карти, геодані)
# -----------------------------------------------------------------------------
# Провайдер розбивки по країнах: geojson | here | carto.
COUNTRY_BREAKDOWN_PROVIDER=geojson
# API-ключ HERE (обов'язковий при COUNTRY_BREAKDOWN_PROVIDER=here; також для карт на Pages).
HERE_API_KEY=
# API-ключ Carto (потрібен при COUNTRY_BREAKDOWN_PROVIDER=carto).
CARTO_API_KEY=

# -----------------------------------------------------------------------------
# Зберігання файлів: local (диск) | s3 (MinIO / AWS S3)
# Див. RUN.md та docs/specs/file-storage.md
# -----------------------------------------------------------------------------
APP_STORAGE_TYPE=local
# Шлях для локального mvn; у Docker Compose завжди /data/uploads (volume).
APP_STORAGE_LOCAL_BASE_PATH=./data/uploads

# Параметри S3/MinIO (коли APP_STORAGE_TYPE=s3):
APP_STORAGE_S3_ENDPOINT=http://minio:9000
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_BUCKET=tms-uploads
APP_STORAGE_S3_ACCESS_KEY=minioadmin
APP_STORAGE_S3_SECRET_KEY=minioadmin
# path-style URL для MinIO (true) vs virtual-hosted (false для AWS).
APP_STORAGE_S3_PATH_STYLE=true

# -----------------------------------------------------------------------------
# MinIO (локальний S3-сумісний сховище)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
